rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /addresses/{addressId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /paymentMethods/{methodId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── Services & Categories (public read) ────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Workers ────────────────────────────────────────────────────────────
    match /workers/{workerId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == workerId;
      allow create, delete: if false;
    }

    // ── Bookings ───────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.user_id ||
        request.auth.uid == resource.data.worker_id
      );
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.user_id;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.user_id ||
        request.auth.uid == resource.data.worker_id
      );
      allow delete: if false;
    }

    // ── Eco Rewards (public read) ──────────────────────────────────────────
    match /ecoRewards/{rewardId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Carbon Credits (public read) ───────────────────────────────────────
    match /carbonCredits/{creditId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Eco Events (public read) ───────────────────────────────────────────
    match /ecoEvents/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Leaderboard (public read) ──────────────────────────────────────────
    match /leaderboard/{period}/entries/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
